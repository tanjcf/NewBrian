{
  "name": "codex-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first coding agent workbench inspired by Codex.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @codex-forge/desktop dev",
    "dev:agentd": "pnpm --filter @codex-forge/agentd dev",
    "package:win-msi": "pnpm run package:win-msi:test",
    "package:win-msi:test": "powershell -NoLogo -ExecutionPolicy Bypass -File scripts/package-win-msi.ps1 -Channel Test",
    "package:win-msi:production": "powershell -NoLogo -ExecutionPolicy Bypass -File scripts/package-win-msi.ps1 -Channel Production",
    "package:mac": "pnpm --filter @codex-forge/desktop package:mac",
    "build": "pnpm -r build",
    "lint": "pnpm run check",
    "check": "pnpm run check:architecture && pnpm -r check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "script:package-win-msi": "pnpm run package:win-msi:test"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "adm-zip": "0.6.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "browserslist": "4.29.3",
      "dompurify": "3.4.16",
      "app-builder-lib": "26.15.3",
      "electron-builder-squirrel-windows": "26.15.3",
      "form-data": "4.0.6",
      "image-size": "2.0.4",
      "ip-address": "10.7.3",
      "js-yaml": "4.3.2",
      "nanoid@3": "3.3.19",
      "postcss": "8.5.28",
      "http-cache-semantics": "4.3.0",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "vite": "6.4.3"
    }
  }
}
