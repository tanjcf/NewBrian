{
  "name": "@codecn-mac/desktop",
  "version": "0.1.10",
  "description": "codeCN desktop coding agent for macOS",
  "author": "codeCN",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node node_modules/electron-vite/bin/electron-vite.js build",
    "prepare:package-resources": "node build/prepare-package-resources.cjs",
    "package:mac": "node build/package-mac.cjs",
    "package:mac:dir": "node build/package-mac.cjs dir",
    "check": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test:main": "node --experimental-strip-types --test src/main/atomic-file.test.ts src/main/workspace-catalog-durability.test.mjs src/shared/workspace-selection-errors.test.ts src/main/rollout-store.test.ts src/main/openai-wire.test.ts src/main/mcp-framing.test.ts src/main/desktop-control-plane.test.ts",
    "test:storage": "node --experimental-strip-types --test src/main/codex-storage.test.ts src/main/rollout-store.test.ts src/main/openai-wire.test.ts src/main/mcp-framing.test.ts src/main/desktop-control-plane.test.ts src/main/thread-message-reconciliation.test.ts",
    "test:package-resources": "node --test build/prepare-package-resources.test.cjs"
  },
  "dependencies": {
    "@codex-forge/protocol": "workspace:*",
    "@codex-forge/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@uzen/kokoro-js": "1.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "main": "out/main/index.js",
  "build": {
    "appId": "cn.codecn.mac.desktop",
    "productName": "codeCN Mac",
    "electronVersion": "35.7.5",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/package-resources/codecn.config.json",
        "to": "codecn.config.json"
      },
      {
        "from": "build/package-resources/codecn.features.json",
        "to": "codecn.features.json"
      },
      {
        "from": "../../../codecn.bootstrap.json",
        "to": "codecn.bootstrap.json"
      },
      {
        "from": "src/renderer/icon.ico",
        "to": "codecn.ico"
      },
      {
        "from": "build/plugins",
        "to": "plugins"
      },
      {
        "from": "resources/novel-tts",
        "to": "novel-tts"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "codeCN uses the microphone for voice input.",
        "NSSpeechRecognitionUsageDescription": "codeCN uses speech recognition to create chat input.",
        "NSLocalNetworkUsageDescription": "codeCN uses the local network to connect trusted mobile devices and development services."
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
