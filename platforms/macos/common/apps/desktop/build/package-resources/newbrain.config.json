{
  "llm": {
    "provider": "OpenAI",
    "baseUrl": "http://203.0.113.10:8790/v1",
    "apiKey": "",
    "wireApi": "responses",
    "model": "gpt-5.4",
    "reviewModel": "gpt-5.4-mini",
    "reasoningEffort": "medium",
    "disableResponseStorage": true,
    "systemPrompt": "You are a helpful coding assistant for the NewBrain desktop workspace."
  },
  "preferences": {
    "appearance": {
      "theme": "light",
      "density": "comfortable",
      "reduceMotion": false
    },
    "configuration": {
      "requireApprovalForShell": true,
      "saveResponses": false,
      "telemetryEnabled": false
    },
    "personalization": {
      "proactiveUpdates": true,
      "includeVerificationSummary": true,
      "reviewFindingsFirst": true
    },
    "hooks": {
      "beforeCommand": true,
      "afterCommand": true,
      "beforeCommit": true,
      "afterTask": true,
      "beforeCommandScript": "",
      "afterCommandScript": "",
      "beforeCommitScript": "",
      "afterTaskScript": ""
    },
    "git": {
      "statusCommand": "git status --short --branch",
      "branchPrefix": "codex/",
      "showDiffBeforeCommit": true,
      "confirmBeforePush": true
    },
    "environment": {
      "terminalShell": "/bin/zsh",
      "extraEnv": {},
      "autoBootstrapConda": true
    },
    "worktree": {
      "defaultIsolated": true,
      "keepArchived": false,
      "rootDir": ""
    },
    "browser": {
      "autoOpenPreview": true,
      "preserveTabs": true,
      "highResScreenshots": false,
      "previewUrl": "http://203.0.113.10:8790"
    }
  },
  "mcpServers": []
}
